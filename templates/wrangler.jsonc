{
  // Cloudflare Workers config for a static-export Next.js build (output:
  // 'export' in next.config, producing ./out). bootstrap.py does not own
  // next.config.js/ts — add the static-export setting to the app scaffold
  // before deploying.
  "name": "__REPOSITORY_NAME__",
  "compatibility_date": "2025-01-01",
  "assets": {
    "directory": "./out"
  },
  // true ships an immediate https://<name>.<subdomain>.workers.dev URL, which
  // release-please-cloudflare-deploy-job.yml relies on for its smoke test and
  // recorded GitHub Deployment. Once a custom domain is ready, set this to
  // false and add a "routes" array (e.g. [{ "pattern": "example.com/*",
  // "custom_domain": true }]) — bootstrap.py cannot infer a domain, so this
  // is a placeholder to fill in, not a default the generated repo ships with.
  "workers_dev": true
}
